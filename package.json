{
  "name": "aio-subtitles",
  "version": "1.0.0",
  "description": "Unified Stremio & Nuvio subtitle aggregator with multi-provider search, language normalization, remapping, and custom formatting.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "test": "tsx test/providerValidation.test.ts && tsx test/persistenceStorage.test.ts && tsx test/formatter.test.ts && tsx test/alignment.test.ts && tsx test/supabase.test.ts",
    "test:providers": "tsx test/providerValidation.test.ts",
    "test:persistence": "tsx test/persistenceStorage.test.ts",
    "test:formatter": "tsx test/formatter.test.ts",
    "test:alignment": "tsx test/alignment.test.ts",
    "test:supabase": "tsx test/supabase.test.ts",
    "test:validation": "tsx test/openSubtitlesAndUiValidation.test.ts",
    "start": "node dist/index.js",
    "render-build": "bash scripts/render-build.sh",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "subtitles",
    "nuvio",
    "opensubtitles",
    "subdl",
    "subsource",
    "addic7ed"
  ],
  "author": "AIOSubtitles Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "iconv-lite": "^0.6.3",
    "lru-cache": "^11.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "simple-icons": "^16.32.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
