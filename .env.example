# Server Configuration
PORT=7000
HOST=0.0.0.0
# Public URL where the addon is reachable (e.g. https://subtitles.yourdomain.com)
BASE_URL=

# Default Provider API Keys (optional server-side fallbacks)
# OpenSubtitles.com REST API Key (register at https://www.opensubtitles.com/api)
OPENSUBTITLES_API_KEY=

# SubDL API Key (register at https://subdl.com)
SUBDL_API_KEY=

# Subsource API Key (if required by endpoint)
SUBSOURCE_API_KEY=

# Cache Settings
CACHE_TTL_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=150

# Environment
NODE_ENV=production
