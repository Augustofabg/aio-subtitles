# Server Configuration
PORT=7000
HOST=0.0.0.0
# Public URL where the addon is reachable (e.g. https://subtitles.yourdomain.com)
BASE_URL=

# Persistent External Database (Render PostgreSQL, Neon, Supabase, etc.)
# If defined, user configurations and passwords are saved in PostgreSQL (never lost on deploys).
# If left empty, the addon falls back to local storage (./data/configurations.json).
DATABASE_URL=
# Custom local data directory (optional fallback)
DATA_DIR=

# Default Provider API Keys (optional server-side fallbacks)
# OpenSubtitles.com REST API Key (register at https://www.opensubtitles.com/api)
OPENSUBTITLES_API_KEY=

# SubDL API Key (register at https://subdl.com)
SUBDL_API_KEY=

# Subsource API Key (if required by endpoint)
SUBSOURCE_API_KEY=

# Cache Settings
CACHE_TTL_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=150

# Environment
NODE_ENV=production
